<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "program": the program file, signed
     before the installer is built. Version info comes from src/app/app.rc.in. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="fmplayeranalyzer.exe"
             product-name="FM Player Analyzer"
             product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
