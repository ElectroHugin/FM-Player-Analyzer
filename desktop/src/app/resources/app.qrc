<RCC>
    <qresource prefix="/defaults">
        <file>definitions.json</file>
        <!-- FM27 roles: generated by scripts/make_definitions_fm27.py. -->
        <file>definitions_fm27.json</file>
    </qresource>
    <!-- Edmund's FM27 view filters (.fmf), installed into the game's views
         folder on request (Settings -> Club, installer task). -->
    <qresource prefix="/views">
        <file alias="FM27-PlayerAnalyzer-PlayerDatabase-Standard.fmf">views/FM27-PlayerAnalyzer-PlayerDatabase-Standard.fmf</file>
        <file alias="FM27-PlayerAnalyzer-Shortlist-Standard.fmf">views/FM27-PlayerAnalyzer-Shortlist-Standard.fmf</file>
        <file alias="FM27-PlayerAnalyzer-Squad-Standard.fmf">views/FM27-PlayerAnalyzer-Squad-Standard.fmf</file>
    </qresource>
    <!-- Edmund's standard tactic as a game file (.fmf) for import into FM27
         (Settings -> Club, installer task). The analyzer's own copy of it is
         "4-2-3-1 - Bavarian Blitz" in definitions_fm27.json. -->
    <qresource prefix="/tactics">
        <file alias="FM27-PlayerAnalyzer-Tactic-4-2-3-1-Bavarian-Blitz.fmf">tactics/FM27-PlayerAnalyzer-Tactic-4-2-3-1-Bavarian-Blitz.fmf</file>
    </qresource>
    <qresource prefix="/app">
        <file>favicon.ico</file>
        <file>electrohugin.png</file>
    </qresource>
</RCC>
