<RCC>
    <!-- "What's new" after an update: the changelog and its translations. -->
    <qresource prefix="/changelog">
        <file alias="CHANGELOG.md">../../../../CHANGELOG.md</file>
        <file alias="CHANGELOG.de.md">../../../changelog/CHANGELOG.de.md</file>
        <file alias="CHANGELOG.es.md">../../../changelog/CHANGELOG.es.md</file>
        <file alias="CHANGELOG.fr.md">../../../changelog/CHANGELOG.fr.md</file>
        <file alias="CHANGELOG.it.md">../../../changelog/CHANGELOG.it.md</file>
        <file alias="CHANGELOG.ru.md">../../../changelog/CHANGELOG.ru.md</file>
        <file alias="CHANGELOG.zh_CN.md">../../../changelog/CHANGELOG.zh_CN.md</file>
    </qresource>
    <qresource prefix="/defaults">
        <file>definitions.json</file>
        <file alias="harvestgreen-comparison.json">../../../../docs/dwrs/harvestgreen-comparison.json</file>
        <!-- FM27 roles: generated by scripts/make_definitions_fm27.py. -->
        <file>definitions_fm27.json</file>
    </qresource>
    <!-- Edmund's FM27 view filters (.fmf), installed into the game's views
         folder on request (Settings -> Club, installer task). -->
    <qresource prefix="/views">
        <file alias="FM27-PlayerAnalyzer-PlayerDatabase-Standard.fmf">views/FM27-PlayerAnalyzer-PlayerDatabase-Standard.fmf</file>
        <file alias="FM27-PlayerAnalyzer-Shortlist-Standard.fmf">views/FM27-PlayerAnalyzer-Shortlist-Standard.fmf</file>
        <file alias="FM27-PlayerAnalyzer-Squad-Standard.fmf">views/FM27-PlayerAnalyzer-Squad-Standard.fmf</file>
    </qresource>
    <!-- Edmund's standard tactic as a game file (.fmf) for import into FM27
         (Settings -> Club, installer task). The analyzer's own copy of it is
         the example tactics in definitions_fm27.json. -->
    <qresource prefix="/tactics">
        <file alias="FM27-PlayerAnalyzer-Tactic-Control-Press-4-2-3-1.fmf">tactics/FM27-PlayerAnalyzer-Tactic-Control-Press-4-2-3-1.fmf</file>
        <file alias="FM27-PlayerAnalyzer-Tactic-Counter-Surge-3-4-2-1.fmf">tactics/FM27-PlayerAnalyzer-Tactic-Counter-Surge-3-4-2-1.fmf</file>
    </qresource>
    <qresource prefix="/app">
        <file>favicon.ico</file>
        <file>electrohugin.png</file>
    </qresource>
</RCC>
